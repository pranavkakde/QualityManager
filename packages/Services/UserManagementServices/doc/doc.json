{
  "openapi": "3.0.0",
  "info": {
    "description": "This is the spec for User and Group Management services",
    "version": "1.0.0",
    "title": "User and Group Management Services",
    "contact": {
      "email": "pranavkakde@gmail.com"
    }
  },
  "tags": [
    {
      "name": "user",
      "description": "user management services"
    },
    {
      "name": "group",
      "description": "group management services"
    }
  ],
  "paths": {
    "/user": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Create user",
        "description": "add user details",
        "operationId": "addUser",
        "requestBody": {
          "$ref": "#/components/requestBodies/User"
        },
        "responses": {
          "201": {
            "description": "User record inserted succesfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Logs user into the system",
        "description": "",
        "operationId": "loginUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "description": "User object",
          "required": true
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "headers": {
              "X-Rate-Limit": {
                "description": "calls per hour allowed by the user",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-Expires-After": {
                "description": "date in UTC when token expires",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid username/password supplied"
          }
        }
      }
    },
    "/user/logout": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Logs out current logged in user session",
        "description": "",
        "operationId": "logoutUser",
        "responses": {
          "default": {
            "description": "successful operation"
          }
        }
      }
    },
    "/user/{username}": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Get user by user name",
        "description": "",
        "operationId": "getUser",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "description": "user name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "User details not found"
          },
          "422": {
            "description": "validation failed"
          },
          "500": {
            "description": "internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "user"
        ],
        "summary": "update user details",
        "description": "update user details",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "description": "user name to be updated",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/User"
        },
        "responses": {
          "200": {
            "description": "User record updated succesfully"
          },
          "400": {
            "description": "user details not found"
          },
          "422": {
            "description": "Validations failed"
          },
          "500": {
            "description": "internal server error"
          }
        }
      },
      "delete": {
        "tags": [
          "user"
        ],
        "summary": "Delete user",
        "description": "Delete user details",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "description": "The name that needs to be deleted",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User record deleted successfully"
          },
          "400": {
            "description": "User details not found"
          },
          "500": {
            "description": "internal server error"
          }
        }
      }
    },
    "/group": {
      "post": {
        "tags": [
          "group"
        ],
        "summary": "Create group",
        "description": "add group details",
        "operationId": "addGroup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Group"
              }
            }
          },
          "description": "User object",
          "required": true
        },
        "responses": {
          "201": {
            "description": "Group record inserted succesfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Group"
                }
              }
            }
          },
          "400": {
            "description": "Group record not found"
          },
          "500": {
            "description": "internal server error"
          }
        }
      }
    },
    "/group/{groupid}": {
      "get": {
        "tags": [
          "group"
        ],
        "summary": "Get group by group id",
        "description": "get group id",
        "operationId": "getGroup",
        "parameters": [
          {
            "name": "groupid",
            "in": "path",
            "description": "Group Id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Group"
                }
              }
            }
          },
          "400": {
            "description": "Group details not found"
          },
          "422": {
            "description": "validation failed"
          },
          "500": {
            "description": "internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "group"
        ],
        "summary": "update group details",
        "description": "update group details",
        "operationId": "updateGroup",
        "parameters": [
          {
            "name": "groupid",
            "in": "path",
            "description": "group idto be updated",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Group"
              }
            }
          },
          "description": "Group object",
          "required": true
        },
        "responses": {
          "200": {
            "description": "Group record updated succesfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Group"
                }
              }
            }
          },
          "400": {
            "description": "group details not found"
          },
          "422": {
            "description": "Validations failed"
          },
          "500": {
            "description": "internal server error"
          }
        }
      },
      "delete": {
        "tags": [
          "group"
        ],
        "summary": "Delete group",
        "description": "Delete group details",
        "operationId": "deleteGroup",
        "parameters": [
          {
            "name": "groupid",
            "in": "path",
            "description": "The id that needs to be deleted",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Group record deleted successfully"
          },
          "400": {
            "description": "Group details not found"
          },
          "500": {
            "description": "internal server error"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://localhost:7777"
    }
  ],
  "components": {
    "requestBodies": {
      "User": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/User"
            }
          }
        },
        "description": "User object",
        "required": true
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "token",
        "in": "header"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "groupid": {
            "type": "integer"
          }
        }
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "groupname": {
            "type": "string"
          },
          "groupid": {
            "type": "integer"
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}